[all:vars]
NOTEBOOK_LOCATION='/home/robot/robomo-club-robot/notebooks'
local_user='operator'

# Two robots share this repo: 'robot' is the club robot (ssh alias from ~/.ssh/config;
# answers at robmo-club-robot.local on its ROBOMO-ROBOT-5G WiFi, IP varies by network),
# 'tx2' is Josh's home TX2 dev robot. Pick one with --limit, e.g.:
#   ansible-playbook -i production all.yml --limit tx2
[robots]
robot
tx2 ansible_host=tx2.local ansible_user=operator

[jupyter_notebook]
robot
tx2

[robot_hardware]
robot
tx2
